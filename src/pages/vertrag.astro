---
import Layout from '../layouts/Layout.astro';
import PageSection from '../components/PageSection.astro';
import Icon from '../components/Icon.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getInvoices } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let invoices: { number: string; date: string; pdfUrl?: string; csvUrl?: string }[] = [];

if (session) {
  try {
    invoices = await getInvoices(session);
  } catch {}
}
---

<Layout title="Tango — Mein Vertrag">
  {session ? (
    <PageSection
      title="Mein Vertrag"
      subtitle="Rechnungsarchiv und SIM-Karten-Verwaltung"
      cardTitle="Rechnungsarchiv"
      cardSubtitle="Ihre Rechnungen als PDF und CSV"
    >
      {invoices.length > 0 ? (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Rechnungsnr.</th>
                <th>Datum</th>
                <th>PDF</th>
                <th>CSV</th>
              </tr>
            </thead>
            <tbody>
              {invoices.map(inv => (
                <tr>
                  <td>{inv.number}</td>
                  <td>{inv.date}</td>
                  <td>{inv.pdfUrl ? <a href={inv.pdfUrl} target="_blank" rel="noopener">PDF</a> : '—'}</td>
                  <td>{inv.csvUrl ? <a href={inv.csvUrl} target="_blank" rel="noopener">CSV</a> : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          <Icon name="file-text" size={32} class="empty-state__icon" />
          <p>Sie haben noch keine Rechnungen erhalten.</p>
        </div>
      )}
    </PageSection>
  ) : (
    <Unauth pageName="Vertragsdaten" />
  )}
</Layout>
