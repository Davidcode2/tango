---
import Layout from '../layouts/Layout.astro';
import PageSection from '../components/PageSection.astro';
import Icon from '../components/Icon.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getStatistics } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let links: { text: string; url: string }[] = [];
let loadError = false;

if (session) {
  try {
    const info = await getStatistics(session);
    links = info.links;
  } catch {
    loadError = true;
  }
}
---

<Layout title="Tango — Statistiken">
  {session ? (
    <PageSection
      title="Statistiken"
      subtitle="Ihre Übersicht zu Einwahl-Accounts und Verbindungen"
      cardTitle="Verbindungsübersicht"
      cardSubtitle="Anruflisten und Einzelverbindungsnachweise"
    >
      {loadError ? (
        <div class="empty-state">
          <Icon name="alert-circle" size={32} class="empty-state__icon" />
          <p>Statistiken konnten nicht geladen werden.</p>
          <p style="font-size: 0.8125rem; margin-top: 0.5rem;">Bitte versuche es später erneut.</p>
        </div>
      ) : links.length > 0 ? (
        <div class="link-list">
          {links.map(l => (
            <a href={l.url} class="link-list__item">
              <span>{l.text}</span>
              <Icon name="arrow-right" size={16} class="link-list__arrow" />
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <Icon name="bar-chart" size={32} class="empty-state__icon" />
          <p>Keine Statistiken verfügbar.</p>
        </div>
      )}
    </PageSection>
  ) : (
    <Unauth pageName="Statistiken" />
  )}
</Layout>
