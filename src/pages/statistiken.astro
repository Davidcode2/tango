---
import Layout from '../layouts/Layout.astro';
import { getSessionFromRequest } from '../lib/auth';

const session = getSessionFromRequest(Astro.request);
---

<Layout title="Tango — Statistiken">
  {session ? (
    <Fragment>
      <div class="page-header">
        <h1>Statistiken</h1>
        <p>Ihre Übersicht zu Einwahl-Accounts und Verbindungen</p>
      </div>
      <div class="card">
        <div class="card__header">
          <div>
            <div class="card__title">Verbindungsübersicht</div>
            <div class="card__subtitle">Anruflisten und Einzelverbindungsnachweise</div>
          </div>
        </div>
        <div class="link-list">
          <a href="/statistiken/mobilfunk" class="link-list__item">
            <span>Mobilfunk-Statistik</span>
            <span class="link-list__arrow">→</span>
          </a>
        </div>
      </div>
    </Fragment>
  ) : (
    <div class="empty-state">
      <div class="empty-state__icon">🔒</div>
      <p>Bitte zuerst <a href="/">anmelden</a>.</p>
    </div>
  )}
</Layout>
