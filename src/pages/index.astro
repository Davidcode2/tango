---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getDashboard } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let userName = '';
let lastLogin = '';
let services: { text: string; url: string }[] = [];

if (session) {
  try {
    const dashboard = await getDashboard(session);
    userName = dashboard.userName;
    lastLogin = dashboard.lastLogin;
    services = dashboard.services;
  } catch {
    // session expired
  }
}
---

<Layout title={session ? 'Tango — Übersicht' : 'Tango — Anmelden'} hideNav={!session}>
  {session ? (
    <Fragment>
      <div class="page-header">
        <h1>Übersicht</h1>
        <p>Ihr persönlicher Service-Bereich von TNG</p>
      </div>

      {lastLogin && (
        <div class="card">
          <div class="card__header">
            <div>
              <div class="card__title">Konto-Status</div>
              <div class="card__subtitle">Letzte Anmeldung und Aktivität</div>
            </div>
            <div style="color: var(--success); display: flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; font-weight: 500;">
              <Icon name="check-circle" size={16} /> Aktiv
            </div>
          </div>
          <div class="stat-row">
            <div class="stat-row__item">
              <div class="stat-row__label">Angemeldet als</div>
              <div class="stat-row__value">{userName || '—'}</div>
            </div>
            <div class="stat-row__item">
              <div class="stat-row__label">Letzter Login</div>
              <div class="stat-row__value">{lastLogin || '—'}</div>
            </div>
          </div>
        </div>
      )}

      <div class="card">
        <div class="card__header">
          <div>
            <div class="card__title">Schnellzugriff</div>
            <div class="card__subtitle">Ihre Dienste und Vertragsverwaltung</div>
          </div>
        </div>
        <div class="link-list">
          {services.map(s => (
            <a href={s.url} class="link-list__item">
              <span>{s.text}</span>
              <Icon name="arrow-right" size={16} class="link-list__arrow" />
            </a>
          ))}
          {services.length === 0 && (
            <div class="empty-state">
              <Icon name="inbox" size={32} class="empty-state__icon" />
              <p>Keine Dienste verfügbar.</p>
            </div>
          )}
        </div>
      </div>
    </Fragment>
  ) : (
    <Fragment>
      <div class="login-wrapper">
        <div class="login-card">
          <div class="login-card__brand">
            <div style="color: var(--accent-primary); display: flex; justify-content: center; margin-bottom: 0.5rem;">
              <Logo size={32} />
            </div>
            <p>Ihr TNG Kundenportal</p>
          </div>
          <form id="login-form" class="login-form">
            <div class="field">
              <label for="username" class="field__label">Benutzername</label>
              <input id="username" type="text" name="username" class="input" placeholder="z.B. max.mustermann" required autocomplete="username" />
            </div>
            <div class="field">
              <label for="password" class="field__label">Passwort</label>
              <div class="password-wrap">
                <input id="password" type="password" name="password" class="input" placeholder="••••••••" required autocomplete="current-password" />
                <button type="button" class="password-toggle" aria-label="Passwort anzeigen" id="pw-toggle">
                  <Icon name="eye" size={18} class="eye-icon eye-icon--show" />
                  <Icon name="eye-off" size={18} class="eye-icon eye-icon--hide" />
                </button>
              </div>
            </div>
            <button type="submit" class="btn btn--full">Anmelden</button>
          </form>
          <div id="error" class="login-error" style="display: none;"></div>
          <div class="login-footer">
            <a href="https://www.mytng.de/web/guest/home">Passwort vergessen?</a>
            <span class="login-footer__links">
              <a href="https://www.tng.de/privatkunden/impressum/">Impressum</a>
              <span> · </span>
              <a href="https://www.tng.de/privatkunden/datenschutz/">Datenschutz</a>
            </span>
          </div>
        </div>
      </div>
      <script is:inline>
        document.getElementById('login-form')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.target;
          const formData = new FormData(form);
          const errorEl = document.getElementById('error');
          errorEl.style.display = 'none';
          const btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          btn.textContent = 'Anmelden…';

          try {
            const res = await fetch('/api/login', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              errorEl.textContent = data.error || 'Login fehlgeschlagen';
              errorEl.style.display = 'block';
              btn.disabled = false;
              btn.textContent = 'Anmelden';
            }
          } catch {
            errorEl.textContent = 'Verbindung fehlgeschlagen';
            errorEl.style.display = 'block';
            btn.disabled = false;
            btn.textContent = 'Anmelden';
          }
        });

        document.getElementById('pw-toggle')?.addEventListener('click', function() {
          const el = document.getElementById('password');
          el.type = el.type === 'password' ? 'text' : 'password';
          this.classList.toggle('is-visible');
        });
      </script>
    </Fragment>
  )}
</Layout>

<style>
  .password-wrap {
    position: relative;
  }
  .password-wrap .input {
    padding-right: 3rem;
  }
  .password-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .password-toggle:hover {
    color: var(--accent-secondary);
    background: var(--accent-soft);
  }
  .eye-icon--hide { display: none; }
  .password-toggle.is-visible .eye-icon--show { display: none; }
  .password-toggle.is-visible .eye-icon--hide { display: block; }

  .login-footer {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .login-footer__links {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .login-footer__links a {
    color: var(--text-secondary);
  }
  .login-footer__links a:hover {
    color: var(--accent-secondary);
  }

  /* Stat row (Übersicht) */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .stat-row__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-row__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .stat-row__value {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
