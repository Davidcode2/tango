---
import Layout from '../layouts/Layout.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getDashboard } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let userName = '';
let lastLogin = '';
let services: { text: string; url: string }[] = [];

if (session) {
  try {
    const dashboard = await getDashboard(session);
    userName = dashboard.userName;
    lastLogin = dashboard.lastLogin;
    services = dashboard.services;
  } catch {
    // session expired
  }
}
---

<Layout title={session ? 'Tango — Übersicht' : 'Tango — Anmelden'} hideNav={!session}>
  {session ? (
    <Fragment>
      <div class="page-header">
        <h1>Willkommen{userName ? `, ${userName}` : ''}</h1>
        <p>Ihr persönlicher Service-Bereich von TNG</p>
      </div>

      {lastLogin && (
        <div class="stat-grid">
          <div class="stat">
            <div class="stat__label">Letzter Login</div>
            <div class="stat__value">{lastLogin}</div>
          </div>
          <div class="stat">
            <div class="stat__label">Status</div>
            <div class="stat__value" style="color: var(--success);">● Aktiv</div>
          </div>
        </div>
      )}

      <div class="card">
        <div class="card__header">
          <div>
            <div class="card__title">Schnellzugriff</div>
            <div class="card__subtitle">Ihre Dienste und Vertragsverwaltung</div>
          </div>
        </div>
        <div class="link-list">
          {services.map(s => (
            <a href={s.url} class="link-list__item">
              <span>{s.text}</span>
              <span class="link-list__arrow">→</span>
            </a>
          ))}
          {services.length === 0 && (
            <div class="empty-state">
              <div class="empty-state__icon">◉</div>
              <p>Keine Dienste verfügbar.</p>
            </div>
          )}
        </div>
      </div>
    </Fragment>
  ) : (
    <Fragment>
      <div class="login-wrapper">
        <div class="login-card">
          <div class="login-card__brand">
            <h1>⚡ Tango</h1>
            <p>Ihr TNG Kundenportal</p>
          </div>
          <form id="login-form" class="login-form">
            <div class="field">
              <label for="username" class="field__label">Benutzername</label>
              <input id="username" type="text" name="username" class="input" placeholder="z.B. max.mustermann" required autocomplete="username" />
            </div>
            <div class="field">
              <label for="password" class="field__label">Passwort</label>
              <div class="password-wrap">
                <input id="password" type="password" name="password" class="input" placeholder="••••••••" required autocomplete="current-password" />
                <button type="button" class="password-toggle" aria-label="Passwort anzeigen">
                  <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
            </div>
            <button type="submit" class="btn btn--full">Anmelden</button>
          </form>
          <div id="error" class="login-error" style="display: none;"></div>
          <div class="login-footer">
            <a href="https://www.mytng.de/web/guest/home">Passwort vergessen?</a>
            <span class="login-footer__links">
              <a href="https://www.tng.de/privatkunden/impressum/">Impressum</a>
              <span> · </span>
              <a href="https://www.tng.de/privatkunden/datenschutz/">Datenschutz</a>
            </span>
          </div>
        </div>
      </div>
      <script is:inline>
        document.getElementById('login-form')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.target;
          const formData = new FormData(form);
          const errorEl = document.getElementById('error');
          errorEl.style.display = 'none';
          const btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          btn.textContent = 'Anmelden…';

          try {
            const res = await fetch('/api/login', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              errorEl.textContent = data.error || 'Login fehlgeschlagen';
              errorEl.style.display = 'block';
              btn.disabled = false;
              btn.textContent = 'Anmelden';
            }
          } catch {
            errorEl.textContent = 'Verbindung fehlgeschlagen';
            errorEl.style.display = 'block';
            btn.disabled = false;
            btn.textContent = 'Anmelden';
          }
        });

        // Password visibility toggle
        document.querySelector('.password-toggle')?.addEventListener('click', function() {
          const el = document.getElementById('password');
          el.type = el.type === 'password' ? 'text' : 'password';
          this.classList.toggle('is-visible');
        });
      </script>
    </Fragment>
  )}
</Layout>

<style>
  .password-wrap {
    position: relative;
  }
  .password-wrap .input {
    padding-right: 3rem;
  }
  .password-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .password-toggle:hover {
    color: var(--accent-secondary);
    background: var(--accent-soft);
  }
  .password-toggle.is-visible {
    color: var(--accent-secondary);
  }
  .eye-icon {
    display: block;
  }
  .login-footer {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .login-footer__links {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }
  .login-footer__links a {
    color: var(--text-secondary);
  }
  .login-footer__links a:hover {
    color: var(--accent-secondary);
  }
</style>
