---
import Layout from '../layouts/Layout.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getServices } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let title = 'Dienste';
let description = 'Sprach- und Datendienste konfigurieren';
let links: { text: string; url: string }[] = [];

if (session) {
  try {
    const info = await getServices(session);
    title = info.title;
    description = info.description;
    links = info.links;
  } catch {
    // session expired
  }
}
---

<Layout title={`Tango — ${title}`}>
  {session ? (
    <Fragment>
      <div class="page-header">
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <div class="card">
        <div class="card__header">
          <div>
            <div class="card__title">Verfügbare Dienste</div>
            <div class="card__subtitle">Telefon, Fax, E-Mail und Webmailer</div>
          </div>
        </div>
        <div class="link-list">
          {links.map(l => (
            <a href={l.url} class="link-list__item">
              <span>{l.text}</span>
              <span class="link-list__arrow">→</span>
            </a>
          ))}
          {links.length === 0 && (
            <div class="empty-state">
              <div class="empty-state__icon">◉</div>
              <p>Keine Dienste verfügbar.</p>
            </div>
          )}
        </div>
      </div>
    </Fragment>
  ) : (
    <Unauth pageName="Dienste" />
  )}
</Layout>
