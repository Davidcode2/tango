---
import Layout from '../layouts/Layout.astro';
import PageSection from '../components/PageSection.astro';
import Icon from '../components/Icon.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getSIMCards } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let sims: { number: string; status: string }[] = [];

if (session) {
  try {
    sims = await getSIMCards(session);
  } catch {}
}
---

<Layout title="Tango — SIM-Karten">
  {session ? (
    <PageSection
      title="SIM-Karten"
      subtitle="Verwaltung und Aktivierung Ihrer TNG SIM-Karten"
      cardTitle="Meine SIM-Karten"
      cardSubtitle="Übersicht und Status"
    >
      <Fragment slot="action">
        <button class="btn btn--ghost btn--sm" onclick="window.location.reload()">
          <Icon name="refresh" size={14} /> Aktualisieren
        </button>
      </Fragment>
      {sims.length > 0 ? (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Nummer</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {sims.map(sim => (
                <tr>
                  <td>{sim.number}</td>
                  <td>
                    <span class:list={["badge", sim.status === 'Aktiv' ? 'badge--success' : 'badge--warning']}>
                      {sim.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">
          <Icon name="credit-card" size={32} class="empty-state__icon" />
          <p>Sie haben keine SIM-Karten.</p>
        </div>
      )}
    </PageSection>
  ) : (
    <Unauth pageName="SIM-Karten" />
  )}
</Layout>
