---
import Layout from '../layouts/Layout.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getSIMCards } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let sims: { number: string; status: string }[] = [];

if (session) {
  try {
    sims = await getSIMCards(session);
  } catch {
    // session expired
  }
}
---

<Layout title="Tango — SIM-Karten">
  {session ? (
    <Fragment>
      <div class="page-header">
        <h1>SIM-Karten</h1>
        <p>Verwaltung und Aktivierung Ihrer TNG SIM-Karten</p>
      </div>
      <div class="card">
        <div class="card__header">
          <div>
            <div class="card__title">Meine SIM-Karten</div>
            <div class="card__subtitle">Übersicht und Status</div>
          </div>
          <button class="btn btn--ghost btn--sm" onclick="window.location.reload()">Aktualisieren</button>
        </div>
        {sims.length > 0 ? (
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Nummer</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {sims.map(sim => (
                  <tr>
                    <td>{sim.number}</td>
                    <td>
                      <span class:list={["badge", sim.status === 'Aktiv' ? 'badge--success' : 'badge--warning']}>
                        {sim.status}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state__icon">⬡</div>
            <p>Sie haben keine SIM-Karten.</p>
          </div>
        )}
      </div>
      <div style="margin-top: 1rem;">
        <a href="/vertrag" class="btn btn--ghost">← Zurück zum Vertrag</a>
      </div>
    </Fragment>
  ) : (
    <Unauth pageName="SIM-Karten" />
  )}
</Layout>
