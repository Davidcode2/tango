---
import Layout from '../layouts/Layout.astro';
import PageSection from '../components/PageSection.astro';
import Icon from '../components/Icon.astro';
import Unauth from '../components/Unauth.astro';
import { getSessionFromRequest } from '../lib/auth';
import { getAccounts } from '../lib/mytng';

const session = getSessionFromRequest(Astro.request);
let links: { text: string; url: string }[] = [];

if (session) {
  try {
    const info = await getAccounts(session);
    links = info.links;
  } catch {}
}
---

<Layout title="Tango — Zugänge">
  {session ? (
    <PageSection
      title="Zugänge"
      subtitle="Ihre Login-Verwaltung"
      cardTitle="Login-Verwaltung"
      cardSubtitle="Homepage, FTP, Webstatistik und Einwahl-Login"
    >
      <div class="link-list">
        {links.map(l => (
          <a href={l.url} class="link-list__item">
            <span>{l.text}</span>
            <Icon name="arrow-right" size={16} class="link-list__arrow" />
          </a>
        ))}
        {links.length === 0 && (
          <div class="empty-state">
            <Icon name="inbox" size={32} class="empty-state__icon" />
            <p>Keine Zugänge verfügbar.</p>
          </div>
        )}
      </div>
    </PageSection>
  ) : (
    <Unauth pageName="Zugänge" />
  )}
</Layout>
