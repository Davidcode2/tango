---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  hideNav?: boolean;
}

const { title = 'Tango', hideNav = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="de" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem('tango-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <div class:list={["page-shell", { "page-shell--centered": hideNav }]}>
      <main class:list={["container", { "container--centered": hideNav }]}>
        <slot />
      </main>
      {!hideNav && (
        <footer class="footer">
          <div>Tango — Alternative TNG Kundenportal UI</div>
          <div class="footer__links">
            <a href="https://www.tng.de/privatkunden/impressum/">Impressum</a>
            <span> · </span>
            <a href="https://www.tng.de/privatkunden/datenschutz/">Datenschutz</a>
            <span> · </span>
            <a href="https://www.mytng.de/web/guest/home">myTNG</a>
          </div>
        </footer>
      )}
    </div>
  </body>
</html>
