---
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
}

const { title = 'Tango' } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #0f0f23;
        color: #e0e0e0;
        min-height: 100vh;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
      }
      .card {
        background: #1a1a2e;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
      }
      .card h2 {
        color: #e94560;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
      }
      .table {
        width: 100%;
        border-collapse: collapse;
      }
      .table th,
      .table td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .table th {
        color: #a0a0b0;
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      a {
        color: #e94560;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .btn {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background: #e94560;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        text-decoration: none;
      }
      .btn:hover {
        background: #c73e54;
        text-decoration: none;
      }
      .empty-state {
        color: #6a6a80;
        text-align: center;
        padding: 2rem;
      }
      .login-form {
        max-width: 400px;
        margin: 4rem auto;
      }
      .login-form input {
        width: 100%;
        padding: 0.75rem;
        margin-bottom: 1rem;
        background: #1a1a2e;
        border: 1px solid #2a2a4e;
        border-radius: 6px;
        color: #e0e0e0;
        font-size: 1rem;
      }
      .login-form input:focus {
        outline: none;
        border-color: #e94560;
      }
      .error {
        color: #e94560;
        margin-bottom: 1rem;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <Nav />
    <main class="container">
      <slot />
    </main>
  </body>
</html>
