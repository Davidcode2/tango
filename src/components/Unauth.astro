---
// Reusable unauthenticated state for protected pages
interface Props {
  pageName: string;
}
const { pageName } = Astro.props;
---

<div class="unauth">
  <div class="unauth__icon">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
  </div>
  <h2 class="unauth__title">Zugriff erforderlich</h2>
  <p class="unauth__text">Melde dich mit deinen myTNG-Zugangsdaten an, um {pageName} zu sehen.</p>
  <a href="/" class="btn unauth__btn">Jetzt anmelden</a>
</div>

<style>
  .unauth {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
    min-height: 50vh;
  }
  .unauth__icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--accent-soft);
    border: 1px solid var(--border-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-secondary);
    margin-bottom: 1.5rem;
  }
  .unauth__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .unauth__text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 360px;
    margin-bottom: 1.5rem;
  }
  .unauth__btn {
    text-decoration: none;
  }
  .unauth__btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }
</style>
