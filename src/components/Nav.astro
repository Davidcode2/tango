---
const navItems = [
  { href: '/', label: 'Übersicht' },
  { href: '/dienste', label: 'Dienste' },
  { href: '/zugaenge', label: 'Zugänge' },
  { href: '/statistiken', label: 'Statistiken' },
  { href: '/vertrag', label: 'Mein Vertrag' },
  { href: '/simkarten', label: 'SIM-Karten' },
];

const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <a href="/" class="nav__logo">⚡ Tango</a>
  <ul class="nav__list">
    {navItems.map(item => (
      <li>
        <a
          href={item.href}
          class:list={["nav__link", { active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: #1a1a2e;
    color: #e0e0e0;
    flex-wrap: wrap;
  }
  .nav__logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: #e94560;
    text-decoration: none;
  }
  .nav__list {
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .nav__link {
    color: #a0a0b0;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .nav__link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .nav__link.active {
    color: #e94560;
    background: rgba(233, 69, 96, 0.1);
  }
  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .nav__list {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
